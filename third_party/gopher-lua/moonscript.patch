+
+// rCodeNot is codenot.
+func (fs *funcState) rCodeNot(p *parser, e *expDesc) {
+	fs.rDischargeVars(e)
+	switch e.k {
+	case vKNil, vKFalse:
+		e.k = vKTrue
+	case vKStr, vKNum, vKTrue:
+		e.k = vKFalse
+	case vRelocable, vNonReloc:
+		fs.rDischarge2AnyReg(p, e)
+		fs.rFreeExp(e)
+		e.k, e.aux = vRelocable, opNot51
+	}
+	e.t, e.f = e.f, e.t
