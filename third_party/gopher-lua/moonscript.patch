+print(addr(io.stdin), addr(io.stdout), addr(io.stderr))
+print(io.type(io.stdout), io.type(42), io.type({}), io.type(nil), try(io.type))
+print(io.stdout:close())
+print(io.stderr:close())
+print(io.close(io.stdin))
