+// its registers from lbase (go-moonscript patch: rkValue with them in
+// mainLoop's locals).
+func rk(reg *registry, consts []LValue, lbase, idx int) LValue {
+	if idx&opBitRk != 0 {
+		return consts[idx&^opBitRk]
+	}
+	return reg.array[lbase+idx]
