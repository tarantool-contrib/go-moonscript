+	switch e.k {
+	case vKStr, vKNum, vKTrue: // no jump
+	case vKFalse, vJmp:
+		e.f = hasJumps51
+	default:
+		fs.rJumpOnCond(p, e)
+		e.f = hasJumps51
+	}
+	e.t = jitNoJump
