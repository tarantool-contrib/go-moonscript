+// rAssignStore stores the values to the targets p.lhs[base:], the last
+// value in e (assignment).
+func (p *parser) rAssignStore(base, nexps int, e *expDesc) {
+	fs := p.fs
+	last := len(p.lhs) - 1
+	nvars := last - base + 1
+	stored := false
+	if nexps != nvars {
+		p.rAdjustAssign(nvars, nexps, e)
+		if nexps > nvars {
+			fs.freereg -= uint32(nexps - nvars)
+		}
