+
+// benchSources are the archives' sources that parse under LuaJIT.
+func benchSources(b *testing.B) (srcs [][]byte, size int64) {
+	files := archiveFiles(b)
+	for _, name := range sortedKeys(files) {
+		src := files[name]
+		if _, err := parse.ParseChunk(src, "bench", parse.Options{Dialect: parse.LuaJIT, Shebang: true}); err == nil {
+			srcs = append(srcs, src)
+			size += int64(len(src))
+		}
+	}
+	return srcs, size
+}
+
+// BenchmarkSourceArchives formats the luasuites archives: parsing with
+// the tokens, attaching the comments, printing.
+func BenchmarkSourceArchives(b *testing.B) {
+	srcs, size := benchSources(b)
+	opts := format.Options{Dialect: parse.LuaJIT}
+	b.SetBytes(size)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for b.Loop() {
+		for _, src := range srcs {
+			if _, err := format.Source(src, opts); err != nil {
+				b.Fatal(err)
+			}
+		}
+	}
+}
+
+// BenchmarkParseTokensArchives is the parse that Source starts with, for
+// comparison.
+func BenchmarkParseTokensArchives(b *testing.B) {
+	srcs, size := benchSources(b)
+	b.SetBytes(size)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for b.Loop() {
+		for _, src := range srcs {
+			if _, err := parse.ParseChunk(src, "bench", parse.Options{Dialect: parse.LuaJIT, Shebang: true, Tokens: true}); err != nil {
+				b.Fatal(err)
+			}
+		}
+	}
+}
+
+// BenchmarkCommentMapArchives attaches the comments of the parsed
+// archives.
+func BenchmarkCommentMapArchives(b *testing.B) {
+	srcs, size := benchSources(b)
+	var chunks []*ast.Chunk
+	for _, src := range srcs {
+		c, _ := parse.ParseChunk(src, "bench", parse.Options{Dialect: parse.LuaJIT, Shebang: true, Tokens: true})
+		chunks = append(chunks, c)
+	}
+	b.SetBytes(size)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for b.Loop() {
+		for _, c := range chunks {
+			format.NewCommentMap(c)
+		}
+	}
+}
+
+// BenchmarkNodeArchives prints the parsed trees of the archives in the
+// canonical style (bytes: of the sources).
+func BenchmarkNodeArchives(b *testing.B) {
+	srcs, size := benchSources(b)
+	var chunks []*ast.Chunk
+	for _, src := range srcs {
+		c, _ := parse.ParseChunk(src, "bench", parse.Options{Dialect: parse.LuaJIT, Shebang: true})
+		chunks = append(chunks, c)
+	}
+	opts := format.Options{Dialect: parse.LuaJIT}
+	b.SetBytes(size)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for b.Loop() {
+		for _, c := range chunks {
+			if err := format.Node(io.Discard, c, opts); err != nil {
+				b.Fatal(err)
+			}
+		}
+	}
+}
--- a/format/check_test.go
+++ b/format/check_test.go
@@ -0,0 +1,479 @@
+package format_test
+
+// The checks of the formatter and the printer over a corpus of sources:
+// for a source S that parses and compiles, in a dialect,
+//
+//   - Source(S) parses and compiles to the code S compiles to, but for the
+//     lines (protoDiff);
+//   - Source(Source(S)) is Source(S);
+//   - the comments of Source(S) are those of S, as written, in order;
+//   - the string and numeral tokens of Source(S) are those of S (a
+//     multiset: the order of the operands is kept, but a check of order
+//     would fail on nothing else);
+//   - Node(the tree of S) parses and compiles to the code of S, and
+//     printing its tree again gives the same text.
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	lua "github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/ast"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/format"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/parse"
+)
+
+var dialects = []parse.Dialect{parse.Lua51, parse.LuaJIT}
+
+func dialectName(d parse.Dialect) string {
+	if d == parse.LuaJIT {
+		return "LuaJIT"
+	}
+	return "Lua51"
+}
+
+func luaDialect(d parse.Dialect) lua.Dialect {
+	if d == parse.LuaJIT {
+		return lua.DialectLuaJIT
+	}
+	return lua.DialectLua51
+}
+
+// compile parses (as Source does) and compiles src.
+func compile(src []byte, d parse.Dialect) (*lua.FunctionProto, error) {
+	chunk, err := parse.ParseChunk(src, "check", parse.Options{Dialect: d, Shebang: true})
+	if err != nil {
+		return nil, err
+	}
+	return lua.CompileAST(chunk.Stmts, "=check", luaDialect(d))
+}
+
+// luaCompile compiles a tree.
+func luaCompile(stmts []ast.Stmt, d parse.Dialect) (*lua.FunctionProto, error) {
+	return lua.CompileAST(stmts, "=check", luaDialect(d))
+}
+
+// protoDiff compares two function prototypes but for their lines: the
+// code, the constants, the nested prototypes, the counts of upvalues,
+// parameters and registers, the vararg flag and the debug names of the
+// locals (with their pc ranges), the calls and the upvalues. It returns
+// the first difference, "" if none.
+func protoDiff(a, b *lua.FunctionProto, where string) string {
+	switch {
+	case a.NumUpvalues != b.NumUpvalues:
+		return fmt.Sprintf("%s: upvalues %d, %d", where, a.NumUpvalues, b.NumUpvalues)
+	case a.NumParameters != b.NumParameters:
+		return fmt.Sprintf("%s: parameters %d, %d", where, a.NumParameters, b.NumParameters)
+	case a.IsVarArg != b.IsVarArg:
+		return fmt.Sprintf("%s: vararg %d, %d", where, a.IsVarArg, b.IsVarArg)
+	case a.NumUsedRegisters != b.NumUsedRegisters:
+		return fmt.Sprintf("%s: registers %d, %d", where, a.NumUsedRegisters, b.NumUsedRegisters)
+	case len(a.Code) != len(b.Code):
+		return fmt.Sprintf("%s: %d instructions, %d", where, len(a.Code), len(b.Code))
+	case len(a.Constants) != len(b.Constants):
+		return fmt.Sprintf("%s: %d constants, %d", where, len(a.Constants), len(b.Constants))
+	case len(a.FunctionPrototypes) != len(b.FunctionPrototypes):
+		return fmt.Sprintf("%s: %d functions, %d", where, len(a.FunctionPrototypes), len(b.FunctionPrototypes))
+	case len(a.DbgLocals) != len(b.DbgLocals):
+		return fmt.Sprintf("%s: %d locals, %d", where, len(a.DbgLocals), len(b.DbgLocals))
+	case len(a.DbgCalls) != len(b.DbgCalls):
+		return fmt.Sprintf("%s: %d calls, %d", where, len(a.DbgCalls), len(b.DbgCalls))
+	case strings.Join(a.DbgUpvalues, ",") != strings.Join(b.DbgUpvalues, ","):
+		return fmt.Sprintf("%s: upvalues %v, %v", where, a.DbgUpvalues, b.DbgUpvalues)
+	}
+	for i := range a.Code {
+		if a.Code[i] != b.Code[i] {
+			return fmt.Sprintf("%s: instruction %d: %08x, %08x", where, i, a.Code[i], b.Code[i])
+		}
+	}
+	for i := range a.Constants {
+		if !sameConstant(a.Constants[i], b.Constants[i]) {
+			return fmt.Sprintf("%s: constant %d: %v, %v", where, i, a.Constants[i], b.Constants[i])
+		}
+	}
+	for i, l := range a.DbgLocals {
+		m := b.DbgLocals[i]
+		if l.Name != m.Name || l.StartPc != m.StartPc || l.EndPc != m.EndPc {
+			return fmt.Sprintf("%s: local %d: %s %d-%d, %s %d-%d", where, i, l.Name, l.StartPc, l.EndPc, m.Name, m.StartPc, m.EndPc)
+		}
+	}
+	for i, c := range a.DbgCalls {
+		if c.Name != b.DbgCalls[i].Name || c.Pc != b.DbgCalls[i].Pc {
+			return fmt.Sprintf("%s: call %d: %s@%d, %s@%d", where, i, c.Name, c.Pc, b.DbgCalls[i].Name, b.DbgCalls[i].Pc)
+		}
+	}
+	for i := range a.FunctionPrototypes {
+		if d := protoDiff(a.FunctionPrototypes[i], b.FunctionPrototypes[i], fmt.Sprintf("%s/%d", where, i)); d != "" {
+			return d
+		}
+	}
+	return ""
+}
+
+func sameConstant(a, b lua.LValue) bool {
+	if x, ok := a.(lua.LNumber); ok {
+		y, ok := b.(lua.LNumber)
+		if !ok {
+			return false
+		}
+		if math.IsNaN(float64(x)) {
+			return math.IsNaN(float64(y))
+		}
+		return math.Float64bits(float64(x)) == math.Float64bits(float64(y))
+	}
+	if x, ok := a.(lua.LString); ok {
+		y, ok := b.(lua.LString)
+		return ok && x == y
+	}
+	return a.Type() == b.Type() && a.String() == b.String()
+}
+
+// lexemes returns the texts of the tokens of src of the kinds.
+func lexemes(src []byte, d parse.Dialect, kinds ...ast.TokenKind) []string {
+	toks, err := parse.Tokenize(src, "check", parse.Options{Dialect: d, Shebang: true})
+	if err != nil {
+		return []string{"<error: " + err.Error() + ">"}
+	}
+	var out []string
+	for _, t := range toks {
+		for _, k := range kinds {
+			if t.Kind == k {
+				out = append(out, string(t.Text(src)))
+			}
+		}
+	}
+	return out
+}
+
+func sorted(list []string) []string {
+	l := append([]string(nil), list...)
+	sort.Strings(l)
+	return l
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// checkStats counts what the checks compared.
+type checkStats struct {
+	sources, skipped, failed     int
+	bytes, outBytes              int
+	comments, literals, printers int
+}
+
+func (s *checkStats) add(o checkStats) {
+	s.sources += o.sources
+	s.skipped += o.skipped
+	s.failed += o.failed
+	s.bytes += o.bytes
+	s.outBytes += o.outBytes
+	s.comments += o.comments
+	s.literals += o.literals
+	s.printers += o.printers
+}
+
+// checkSource runs the checks on src; it returns the first failure, "" if
+// none, and whether src was checked (it parses and compiles).
+func checkSource(src []byte, opts format.Options, stats *checkStats) (failure string, checked bool) {
+	d := opts.Dialect
+	want, err := compile(src, d)
+	if err != nil {
+		return "", false
+	}
+	stats.bytes += len(src)
+	out, err := format.Source(src, opts)
+	if err != nil {
+		return "format: " + err.Error(), true
+	}
+	stats.outBytes += len(out)
+	got, err := compile(out, d)
+	if err != nil {
+		return fmt.Sprintf("the formatted source does not compile: %v\n%s", err, excerpt(out, err)), true
+	}
+	if diff := protoDiff(want, got, "main"); diff != "" {
+		return "the formatted source compiles to other code: " + diff, true
+	}
+	again, err := format.Source(out, opts)
+	if err != nil {
+		return "format of the formatted source: " + err.Error(), true
+	}
+	if !bytes.Equal(again, out) {
+		return "not idempotent:\n" + firstDiff(out, again), true
+	}
+	c1 := lexemes(src, d, ast.TokenComment)
+	c2 := lexemes(out, d, ast.TokenComment)
+	if !equalStrings(c1, c2) {
+		return fmt.Sprintf("comments differ: %d, %d: %s", len(c1), len(c2), firstStringDiff(c1, c2)), true
+	}
+	stats.comments += len(c1)
+	if opts.Quotes == format.QuotesKeep {
+		l1 := sorted(lexemes(src, d, ast.TokenString, ast.TokenNumber))
+		l2 := sorted(lexemes(out, d, ast.TokenString, ast.TokenNumber))
+		if !equalStrings(l1, l2) {
+			return fmt.Sprintf("literals differ: %d, %d: %s", len(l1), len(l2), firstStringDiff(l1, l2)), true
+		}
+		stats.literals += len(l1)
+	}
+	if f := checkPrinter(src, want, opts); f != "" {
+		return f, true
+	}
+	stats.printers++
+	return "", true
+}
+
+// checkPrinter checks Node on the tree of src, parsed without tokens.
+func checkPrinter(src []byte, want *lua.FunctionProto, opts format.Options) string {
+	d := opts.Dialect
+	chunk, err := parse.ParseChunk(src, "check", parse.Options{Dialect: d, Shebang: true})
+	if err != nil {
+		return "parse: " + err.Error()
+	}
+	var buf bytes.Buffer
+	if err := format.Node(&buf, chunk, opts); err != nil {
+		return "print: " + err.Error()
+	}
+	out := buf.Bytes()
+	got, err := compile(out, d)
+	if err != nil {
+		return fmt.Sprintf("the printed tree does not compile: %v\n%s", err, excerpt(out, err))
+	}
+	if diff := protoDiff(want, got, "main"); diff != "" {
+		return "the printed tree compiles to other code: " + diff
+	}
+	chunk2, err := parse.ParseChunk(out, "check", parse.Options{Dialect: d})
+	if err != nil {
+		return "parse of the printed tree: " + err.Error()
+	}
+	var buf2 bytes.Buffer
+	if err := format.Node(&buf2, chunk2, opts); err != nil {
+		return "print of the printed tree: " + err.Error()
+	}
+	if !bytes.Equal(buf2.Bytes(), out) {
+		return "printing the printed tree differs:\n" + firstDiff(out, buf2.Bytes())
+	}
+	return ""
+}
+
+// excerpt returns the lines around the line of a parse error.
+func excerpt(src []byte, err error) string {
+	var pe *parse.Error
+	if !errors.As(err, &pe) {
+		return ""
+	}
+	lines := strings.Split(string(src), "\n")
+	from, to := max(0, pe.Pos.Line-4), min(len(lines), pe.Pos.Line+2)
+	var b strings.Builder
+	for i := from; i < to; i++ {
+		fmt.Fprintf(&b, "%5d  %s\n", i+1, lines[i])
+	}
+	return b.String()
+}
+
+func firstDiff(a, b []byte) string {
+	la := strings.Split(string(a), "\n")
+	lb := strings.Split(string(b), "\n")
+	for i := 0; i < len(la) || i < len(lb); i++ {
+		var x, y string
+		if i < len(la) {
+			x = la[i]
+		}
+		if i < len(lb) {
+			y = lb[i]
+		}
+		if x != y {
+			from := max(0, i-3)
+			var s strings.Builder
+			for j := from; j < i; j++ {
+				fmt.Fprintf(&s, "   %5d  %s\n", j+1, la[j])
+			}
+			fmt.Fprintf(&s, " - %5d  %s\n + %5d  %s\n", i+1, x, i+1, y)
+			return s.String()
+		}
+	}
+	return ""
+}
+
+func firstStringDiff(a, b []string) string {
+	for i := 0; i < len(a) || i < len(b); i++ {
+		var x, y string
+		if i < len(a) {
+			x = a[i]
+		}
+		if i < len(b) {
+			y = b[i]
+		}
+		if x != y {
+			return fmt.Sprintf("#%d %q, %q", i, x, y)
+		}
+	}
+	return ""
+}
+
+// runChecks runs the checks over files in both dialects.
+func runChecks(t *testing.T, label string, files map[string][]byte, opts format.Options) {
+	t.Helper()
+	for _, d := range dialects {
+		var total checkStats
+		o := opts
+		o.Dialect = d
+		for _, name := range sortedKeys(files) {
+			var st checkStats
+			st.sources = 1
+			f, checked := checkSource(files[name], o, &st)
+			if !checked {
+				st.skipped = 1
+			}
+			if f != "" {
+				st.failed = 1
+				if total.failed < 10 {
+					t.Errorf("%s (%s): %s", name, dialectName(d), f)
+				}
+			}
+			total.add(st)
+		}
+		t.Logf("%s, %s: %d sources (%d do not compile), %d formatted (%d bytes to %d): %d fail; %d comments, %d literals, %d printed trees compared",
+			label, dialectName(d), total.sources, total.skipped, total.sources-total.skipped, total.bytes, total.outBytes,
+			total.failed, total.comments, total.literals, total.printers)
+	}
+}
+
+/* the corpus */
+
+// luaFiles returns the Lua files under dir (and its subdirectories), by
+// path.
+func luaFiles(tb testing.TB, dir string) map[string][]byte {
+	tb.Helper()
+	files := map[string][]byte{}
+	err := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !d.IsDir() && strings.HasSuffix(path, ".lua") {
+			b, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			files[path] = b
+		}
+		return nil
+	})
+	if err != nil {
+		tb.Fatal(err)
+	}
+	return files
+}
+
+// archivesDir holds go-moonscript's archives of Lua test suites and
+// projects (internal/luasuites).
+var archivesDir = filepath.Join("..", "..", "..", "internal", "luasuites", "testdata", "archives")
+
+// archiveFiles returns the Lua files of the luasuites archives.
+func archiveFiles(tb testing.TB) map[string][]byte {
+	tb.Helper()
+	paths, _ := filepath.Glob(filepath.Join(archivesDir, "*.tar.gz"))
+	if len(paths) == 0 {
+		tb.Skip("no archives in", archivesDir)
+	}
+	files := map[string][]byte{}
+	for _, p := range paths {
+		if err := readTarGz(p, files); err != nil {
+			tb.Fatal(err)
+		}
+	}
+	return files
+}
+
+func readTarGz(path string, files map[string][]byte) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = f.Close() }()
+	zr, err := gzip.NewReader(f)
+	if err != nil {
+		return err
+	}
+	tr := tar.NewReader(zr)
+	for {
+		hdr, err := tr.Next()
+		if errors.Is(err, io.EOF) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if hdr.Typeflag != tar.TypeReg || !strings.HasSuffix(hdr.Name, ".lua") && !strings.HasSuffix(hdr.Name, ".t") {
+			continue
+		}
+		b, err := io.ReadAll(tr)
+		if err != nil {
+			return err
+		}
+		files[filepath.Base(path)+"/"+hdr.Name] = b
+	}
+}
+
+func sortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// TestCheckTestdata runs the checks over the compatibility scripts and the
+// other Lua files of the fork's testdata, and the Lua files of
+// go-moonscript's testdata.
+func TestCheckTestdata(t *testing.T) {
+	files := luaFiles(t, filepath.Join("..", "testdata"))
+	if len(files) == 0 {
+		t.Fatal("no scripts")
+	}
+	runChecks(t, "gopher-lua testdata", files, format.Options{})
+	// go-moonscript's, if the fork is in it
+	if dir := filepath.Join("..", "..", "..", "testdata"); isDir(dir) {
+		runChecks(t, "go-moonscript testdata", luaFiles(t, dir), format.Options{})
+	}
+}
+
+// TestCheckArchives runs the checks over the Lua files of the luasuites
+// archives.
+func TestCheckArchives(t *testing.T) {
+	if testing.Short() {
+		t.Skip("short")
+	}
+	runChecks(t, "archives", archiveFiles(t), format.Options{})
+}
+
+// TestCheckOptions runs the checks over the compatibility scripts with the
+// other options: narrow lines, tabs, quotes, trailing commas, semicolons.
+func TestCheckOptions(t *testing.T) {
+	files := luaFiles(t, filepath.Join("..", "testdata", "compat"))
+	runChecks(t, "compat, narrow", files, format.Options{Width: 40, UseTabs: true, TrailingComma: true, KeepSemicolons: true})
+	runChecks(t, "compat, quotes", files, format.Options{Quotes: format.QuotesSingle, IndentWidth: 2})
+}
+
+func isDir(path string) bool {
+	fi, err := os.Stat(path)
+	return err == nil && fi.IsDir()
+}
--- a/format/comments.go
+++ b/format/comments.go
@@ -0,0 +1,577 @@
+package format
+
+import (
+	"bytes"
+	"sort"
+
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/ast"
+)
+
+// Place is where a comment goes relative to the element it is attached
+// to.
+type Place uint8
+
+const (
+	// Leading: before the element, on the lines above it or on its line
+	// before it.
+	Leading Place = iota
+	// Trailing: after the element, on the line it ends on.
+	Trailing
+	// Inner: inside the element, between its own tokens (keywords,
+	// punctuation, the names held as strings) where no child element
+	// starts or ends: in an empty block, table, parameter or argument list,
+	// at the end of a block, before a keyword.
+	Inner
+)
+
+func (p Place) String() string {
+	switch p {
+	case Leading:
+		return "leading"
+	case Trailing:
+		return "trailing"
+	case Inner:
+		return "inner"
+	}
+	return "?"
+}
+
+// A Comment is a comment of the source and where it goes.
+type Comment struct {
+	ast.Comment
+	// Raw is the comment as written, from its "--" to its last byte.
+	Raw string
+	// Place is where the comment goes relative to its element.
+	Place Place
+	// SameLine is set if the comment starts on the line of the token
+	// before it (no line break between them).
+	SameLine bool
+	// BlankBefore is set if an empty line separates the comment from the
+	// token or comment before it.
+	BlankBefore bool
+	// NewlineAfter is set if a line break follows the comment before the
+	// next token or comment (always for a short comment).
+	NewlineAfter bool
+	// Index and Next say where an Inner comment goes in its element: after
+	// Index of its children (those starting before it, in source order:
+	// the order of ast.Walk), before the token of kind Next (TokenEOF at
+	// the end of the chunk).
+	Index int
+	Next  ast.TokenKind
+}
+
+// A CommentMap maps the elements of a tree to the comments attached to
+// them, in source order, as go/ast.CommentMap does. Every comment of the
+// source is attached to exactly one element, so that a printer that
+// prints each element's comments with it prints each comment once.
+type CommentMap map[ast.Element][]*Comment
+
+// Comments returns the comments of the map in source order (by their
+// spans; comments without one last, in no particular order).
+func (cm CommentMap) Comments() []*Comment {
+	var list []*Comment
+	for _, cs := range cm {
+		list = append(list, cs...)
+	}
+	sort.SliceStable(list, func(i, j int) bool {
+		a, b := list[i].Span, list[j].Span
+		if (a == ast.Span{}) != (b == ast.Span{}) {
+			return b == ast.Span{}
+		}
+		return a.Start < b.Start
+	})
+	return list
+}
+
+// gap is a run of trivia holding comments, between the grammar tokens p
+// (-1: the start of the source) and n (TokenEOF at the end).
+type gap struct {
+	p, n     int
+	comments []*Comment
+}
+
+// NewCommentMap attaches the comments of a chunk parsed with its tokens
+// (parse.Options.Tokens) to its elements; it returns nil if the chunk has
+// no tokens or no comments. For a comment, let P be the token of the
+// grammar before it and N the one after it, PE the outermost element
+// ending with P (with its parentheses; P being a "," or ";", the token
+// before it) and NE the outermost element starting with N (with its
+// parentheses; else, a comment inside parentheses, without them). The
+// comments between P and N before the first line break between them are
+// on P's line, the others on lines of their own. A comment is attached:
+//
+//   - on P's line and followed by a line break: Trailing to PE, if any,
+//     else Leading to NE (with SameLine: "{ -- c", "then -- c"), else
+//     Inner;
+//   - on P's line and followed by N on the same line: Leading to NE, if
+//     any ("x = --[[c]] 1"), else Trailing to PE, else Inner;
+//   - on a line of its own: Leading to NE, if any, else Inner;
+//   - Inner: to the innermost element holding it (the chunk at its end
+//     or in an empty chunk), with the index of the children before it and
+//     the kind of N: the end of a block (before "end", "else", "until",
+//     the end of the chunk), an empty table, parameter or argument list,
+//     before a keyword, a "," or a name held as a string.
+//
+// So a comment at the end of a line goes with what the line ends with,
+// one on lines above a statement, a field or an argument goes with it,
+// and one at the end of a block, or in an empty block or list, with the
+// element holding the block or list.
+func NewCommentMap(chunk *ast.Chunk) CommentMap {
+	if chunk == nil || len(chunk.Tokens) == 0 || chunk.Lines == nil {
+		return nil
+	}
+	src := chunk.Lines.Source()
+	toks := chunk.Tokens
+	var gaps []gap
+	prev := -1
+	var cur []*Comment
+	nl, broke := 0, false // line breaks since the last token or comment; since prev
+	var last *Comment
+	for i, t := range toks {
+		switch t.Kind {
+		case ast.TokenNewline:
+			nl++
+			broke = true
+			if last != nil {
+				last.NewlineAfter = true
+			}
+			continue
+		case ast.TokenWhitespace, ast.TokenHeader:
+			if t.Kind == ast.TokenHeader {
+				broke = true
+			}
+			continue
+		case ast.TokenComment:
+			s := t.Span()
+			raw := string(src[s.Start:s.End])
+			c := &Comment{Raw: raw}
+			c.Span = s
+			c.Text, c.Long = commentText(raw)
+			c.NewlineAfter = !c.Long
+			c.SameLine = prev >= 0 && !broke
+			c.BlankBefore = nl >= 2
+			cur = append(cur, c)
+			last = c
+			nl = 0
+			if c.Long && bytes.ContainsAny(src[s.Start:s.End], "\r\n") {
+				broke = true
+			}
+			continue
+		}
+		if len(cur) > 0 {
+			gaps = append(gaps, gap{p: prev, n: i, comments: cur})
+			cur = nil
+		}
+		prev, nl, broke, last = i, 0, false, nil
+	}
+	if len(cur) > 0 { // tokens without EOF
+		gaps = append(gaps, gap{p: prev, n: len(toks), comments: cur})
+	}
+	if len(gaps) == 0 {
+		return nil
+	}
+
+	// the elements ending and starting at the offsets of the gaps
+	type ends struct{ outer, inner ast.Element }
+	endAt := map[int]*ends{}
+	startAt := map[int]*ends{}
+	prevGrammar := func(i int) int {
+		for i--; i >= 0 && toks[i].Kind.IsTrivia(); i-- {
+		}
+		return i
+	}
+	pEnd := make([]int, len(gaps))
+	nStart := make([]int, len(gaps))
+	for gi, g := range gaps {
+		pEnd[gi], nStart[gi] = -1, -1
+		if q := g.p; q >= 0 {
+			if toks[q].Kind == ast.TokenComma {
+				q = prevGrammar(q)
+			} else {
+				for q >= 0 && toks[q].Kind == ast.TokenSemicolon {
+					q = prevGrammar(q)
+				}
+			}
+			if q >= 0 {
+				pEnd[gi] = toks[q].Span().End
+				endAt[pEnd[gi]] = &ends{}
+			}
+		}
+		if g.n < len(toks) && toks[g.n].Kind != ast.TokenEOF {
+			nStart[gi] = toks[g.n].Span().Start
+			startAt[nStart[gi]] = &ends{}
+		}
+	}
+	// the offsets, sorted: an element without one in its span, nor its
+	// children, ends or starts at none
+	offs := make([]int, 0, len(endAt)+len(startAt))
+	for o := range endAt {
+		offs = append(offs, o)
+	}
+	for o := range startAt {
+		offs = append(offs, o)
+	}
+	sort.Ints(offs)
+	var visit func(el ast.Element)
+	visit = func(el ast.Element) {
+		s := el.Span()
+		if s == (ast.Span{}) {
+			forEachChild(el, visit)
+			return
+		}
+		o := outerSpan(el)
+		lo, hi := min(o.Start, s.Start), max(o.End, s.End)
+		if i := sort.SearchInts(offs, lo); i == len(offs) || offs[i] > hi {
+			return
+		}
+		// a parent before its children: the outermost first
+		if el != ast.Element(chunk) {
+			if e := endAt[o.End]; e != nil && e.outer == nil {
+				e.outer = el
+			}
+			if e := endAt[s.End]; e != nil && e.inner == nil {
+				e.inner = el
+			}
+			if e := startAt[o.Start]; e != nil && e.outer == nil {
+				e.outer = el
+			}
+			if e := startAt[s.Start]; e != nil && e.inner == nil {
+				e.inner = el
+			}
+		}
+		forEachChild(el, visit)
+	}
+	visit(chunk)
+	pick := func(m map[int]*ends, off int) ast.Element {
+		if off < 0 {
+			return nil
+		}
+		e := m[off]
+		if e.outer != nil {
+			return e.outer
+		}
+		return e.inner
+	}
+
+	cm := CommentMap{}
+	attach := func(el ast.Element, c *Comment, place Place) {
+		c.Place = place
+		if place == Inner {
+			c.Index, c.Next = 0, ast.TokenEOF
+		}
+		cm[el] = append(cm[el], c)
+	}
+	inner := func(g gap, c *Comment) {
+		el, index := container(chunk, c.Span.Start)
+		c.Place = Inner
+		c.Index = index
+		c.Next = ast.TokenEOF
+		if g.n < len(toks) {
+			c.Next = toks[g.n].Kind
+		}
+		cm[el] = append(cm[el], c)
+	}
+	for gi, g := range gaps {
+		pe, ne := pick(endAt, pEnd[gi]), pick(startAt, nStart[gi])
+		// the comments on P's line
+		k := 0
+		for k < len(g.comments) && g.comments[k].SameLine {
+			k++
+		}
+		if k > 0 {
+			lastSame := g.comments[k-1]
+			brokeAfter := k < len(g.comments) || lastSame.NewlineAfter
+			for _, c := range g.comments[:k] {
+				switch {
+				case brokeAfter && pe != nil:
+					attach(pe, c, Trailing)
+				case ne != nil:
+					attach(ne, c, Leading)
+				case pe != nil:
+					attach(pe, c, Trailing)
+				default:
+					inner(g, c)
+				}
+			}
+		}
+		for _, c := range g.comments[k:] {
+			if ne != nil {
+				attach(ne, c, Leading)
+			} else {
+				inner(g, c)
+			}
+		}
+	}
+	return cm
+}
+
+// commentText returns the text of a comment as written, as ast.Comment
+// has it, and whether it is long.
+func commentText(raw string) (string, bool) {
+	body := raw[2:]
+	level := ast.LongBracketLevel([]byte(body))
+	if level < 0 {
+		return body, false
+	}
+	open := level + 2
+	close := level + 2
+	if len(body) < open+close {
+		return "", true
+	}
+	t := body[open : len(body)-close]
+	// a line break right after the opening bracket is skipped
+	if len(t) > 0 && (t[0] == '\n' || t[0] == '\r') {
+		if len(t) > 1 && (t[1] == '\n' || t[1] == '\r') && t[1] != t[0] {
+			t = t[2:]
+		} else {
+			t = t[1:]
+		}
+	}
+	return normalizeNewlines(t), true
+}
+
+// normalizeNewlines turns each line break ("\n", "\r", "\r\n", "\n\r")
+// into "\n".
+func normalizeNewlines(s string) string {
+	if !bytes.ContainsAny([]byte(s), "\r") {
+		return s
+	}
+	var b []byte
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c == '\n' || c == '\r' {
+			if i+1 < len(s) && (s[i+1] == '\n' || s[i+1] == '\r') && s[i+1] != c {
+				i++
+			}
+			b = append(b, '\n')
+			continue
+		}
+		b = append(b, c)
+	}
+	return string(b)
+}
+
+// container returns the innermost element of the chunk whose span holds
+// the offset (strictly inside it), and the number of its children that
+// start before the offset.
+func container(chunk *ast.Chunk, off int) (ast.Element, int) {
+	var el ast.Element = chunk
+	for {
+		var next ast.Element
+		index := 0
+		forEachChild(el, func(c ast.Element) {
+			s := c.Span()
+			if s == (ast.Span{}) {
+				return
+			}
+			if s.Start < off {
+				index++
+			}
+			if next == nil && s.Start < off && off < s.End {
+				next = c
+			}
+		})
+		if next == nil {
+			return el, index
+		}
+		el = next
+	}
+}
+
+// outerSpan is the span of an element with the parentheses around it.
+func outerSpan(el ast.Element) ast.Span {
+	if e, ok := el.(ast.Expr); ok {
+		return e.OuterSpan()
+	}
+	return el.Span()
+}
+
+// forEachChild calls f for the children of el, as ast.Walk has them,
+// skipping nils.
+func forEachChild(el ast.Element, f func(ast.Element)) {
+	stmts := func(list []ast.Stmt) {
+		for _, s := range list {
+			if !isNil(s) {
+				f(s)
+			}
+		}
+	}
+	exprs := func(list []ast.Expr) {
+		for _, e := range list {
+			if !isNil(e) {
+				f(e)
+			}
+		}
+	}
+	expr := func(e ast.Expr) {
+		if !isNil(e) {
+			f(e)
+		}
+	}
+	switch n := el.(type) {
+	case *ast.Chunk:
+		stmts(n.Stmts)
+	case *ast.AssignStmt:
+		exprs(n.Lhs)
+		exprs(n.Rhs)
+	case *ast.LocalAssignStmt:
+		exprs(n.Exprs)
+	case *ast.FuncCallStmt:
+		expr(n.Expr)
+	case *ast.DoBlockStmt:
+		stmts(n.Stmts)
+	case *ast.WhileStmt:
+		expr(n.Condition)
+		stmts(n.Stmts)
+	case *ast.RepeatStmt:
+		stmts(n.Stmts)
+		expr(n.Condition)
+	case *ast.IfStmt:
+		expr(n.Condition)
+		stmts(n.Then)
+		stmts(n.Else)
+	case *ast.NumberForStmt:
+		expr(n.Init)
+		expr(n.Limit)
+		expr(n.Step)
+		stmts(n.Stmts)
+	case *ast.GenericForStmt:
+		exprs(n.Exprs)
+		stmts(n.Stmts)
+	case *ast.FuncDefStmt:
+		if n.Name != nil {
+			f(n.Name)
+		}
+		if n.Func != nil {
+			f(n.Func)
+		}
+	case *ast.ReturnStmt:
+		exprs(n.Exprs)
+	case *ast.AttrGetExpr:
+		expr(n.Object)
+		expr(n.Key)
+	case *ast.TableExpr:
+		for _, fl := range n.Fields {
+			if fl != nil {
+				f(fl)
+			}
+		}
+	case *ast.Field:
+		expr(n.Key)
+		expr(n.Value)
+	case *ast.FuncCallExpr:
+		expr(n.Func)
+		expr(n.Receiver)
+		exprs(n.Args)
+	case *ast.LogicalOpExpr:
+		expr(n.Lhs)
+		expr(n.Rhs)
+	case *ast.RelationalOpExpr:
+		expr(n.Lhs)
+		expr(n.Rhs)
+	case *ast.StringConcatOpExpr:
+		expr(n.Lhs)
+		expr(n.Rhs)
+	case *ast.ArithmeticOpExpr:
+		expr(n.Lhs)
+		expr(n.Rhs)
+	case *ast.UnaryMinusOpExpr:
+		expr(n.Expr)
+	case *ast.UnaryNotOpExpr:
+		expr(n.Expr)
+	case *ast.UnaryLenOpExpr:
+		expr(n.Expr)
+	case *ast.FunctionExpr:
+		if n.ParList != nil {
+			f(n.ParList)
+		}
+		stmts(n.Stmts)
+	case *ast.FuncName:
+		expr(n.Func)
+		expr(n.Receiver)
+	}
+}
+
+// isNil reports whether an element is nil or a nil pointer of the types
+// of package ast.
+func isNil(el any) bool {
+	switch n := el.(type) {
+	case nil:
+		return true
+	case *ast.AssignStmt:
+		return n == nil
+	case *ast.LocalAssignStmt:
+		return n == nil
+	case *ast.FuncCallStmt:
+		return n == nil
+	case *ast.DoBlockStmt:
+		return n == nil
+	case *ast.WhileStmt:
+		return n == nil
+	case *ast.RepeatStmt:
+		return n == nil
+	case *ast.IfStmt:
+		return n == nil
+	case *ast.NumberForStmt:
+		return n == nil
+	case *ast.GenericForStmt:
+		return n == nil
+	case *ast.FuncDefStmt:
+		return n == nil
+	case *ast.ReturnStmt:
+		return n == nil
+	case *ast.BreakStmt:
+		return n == nil
+	case *ast.LabelStmt:
+		return n == nil
+	case *ast.GotoStmt:
+		return n == nil
+	case *ast.TrueExpr:
+		return n == nil
+	case *ast.FalseExpr:
+		return n == nil
+	case *ast.NilExpr:
+		return n == nil
+	case *ast.NumberExpr:
+		return n == nil
+	case *ast.StringExpr:
+		return n == nil
+	case *ast.CdataNumberExpr:
+		return n == nil
+	case *ast.Comma3Expr:
+		return n == nil
+	case *ast.IdentExpr:
+		return n == nil
+	case *ast.AttrGetExpr:
+		return n == nil
+	case *ast.TableExpr:
+		return n == nil
+	case *ast.FuncCallExpr:
+		return n == nil
+	case *ast.LogicalOpExpr:
+		return n == nil
+	case *ast.RelationalOpExpr:
+		return n == nil
+	case *ast.StringConcatOpExpr:
+		return n == nil
+	case *ast.ArithmeticOpExpr:
+		return n == nil
+	case *ast.UnaryMinusOpExpr:
+		return n == nil
+	case *ast.UnaryNotOpExpr:
+		return n == nil
+	case *ast.UnaryLenOpExpr:
+		return n == nil
+	case *ast.FunctionExpr:
+		return n == nil
+	case *ast.Field:
+		return n == nil
+	case *ast.ParList:
+		return n == nil
+	case *ast.FuncName:
+		return n == nil
+	case *ast.Chunk:
+		return n == nil
+	}
+	return false
+}
--- a/format/doc.go
+++ b/format/doc.go
@@ -0,0 +1,99 @@
+// Package format prints Lua 5.1 and LuaJIT syntax trees as source and
+// formats sources: a printer for trees that other code built or
+// transformed, and a formatter, gofmt's kind, that keeps what the author
+// of a source chose. go-moonscript patch.
+//
+//	out, err := format.Source(src, format.Options{Dialect: parse.LuaJIT})
+//
+//	chunk, err := parse.ParseChunk(src, name, parse.Options{Tokens: true})
+//	cm := format.NewCommentMap(chunk) // the comments, attached to elements
+//	// ... transform chunk ...
+//	err = format.Chunk(w, chunk, cm, opts)
+//
+//	err = format.Node(w, tree, opts) // a built tree, canonical
+//
+// # Correctness
+//
+// What the printer and the formatter write parses, in the dialect of the
+// options, to a tree that compiles to the same code as the tree printed
+// (the instructions, constants, functions, upvalues, locals and registers;
+// only the lines differ): the tests check it over the compatibility
+// scripts, the fork's test scripts and the luasuites archives in both
+// dialects, and fuzz it. Formatting a formatted source changes nothing,
+// and the formatter keeps the comments of the source as written and in
+// order, and its string and numeral tokens.
+//
+// To that end the printer writes:
+//
+//   - the parentheses that precedence, associativity and the grammar need
+//     (operands, a prefix expression that is not one: ("s"):rep(2), (f or
+//     g)(), ({}).k), and those of a call or "..." truncated to one value
+//     (FuncCallExpr.AdjustRet, Comma3Expr.AdjustRet) at the end of an
+//     expression list, an argument list or a table, where the truncation
+//     matters; the formatter keeps those of the source as well;
+//   - a.b only if b is a name of the dialect ("goto" is a keyword of
+//     LuaJIT), else a["b"];
+//   - strings with escapes that read back as the same bytes in both
+//     dialects (decimal escapes; valid UTF-8 as is), numerals that read
+//     back as the same number (the infinity as 1e999, a negative value with
+//     a unary minus, NaN as 0 / 0, which the compiler folds);
+//   - no line break before the "(" of arguments ("f\n(g)" is Lua's
+//     ambiguous syntax: comments that go there are written after the "("),
+//     a ";" before a statement that starts with "(", a space between two
+//     tokens that would make one ("- -x", "a .. .5", "1 .. 2", "t[ [[s]]]").
+//
+// # Comments
+//
+// A CommentMap attaches each comment of a source to an element of its
+// tree (NewCommentMap has the rules): Leading, on the lines above it or
+// before it on its line; Trailing, after it on the line it ends on; Inner,
+// in an element where no child is (an empty block, table or list, the end
+// of a block, before a keyword). The printer writes each comment of the map
+// once, with its element: leading ones before it, trailing ones after it
+// (after the "," or ";" that follows it), inner ones before the token of
+// the element they were before, or at the end of the element. A short
+// comment ends its line. So comments follow their elements when a
+// transformation moves them; those of elements no longer in the tree are an
+// error of Chunk, not lost silently.
+//
+// # Style
+//
+// The style is the package's own. Statements are one a line, blocks
+// indented one level (4 spaces, IndentWidth, or tabs), binary operators,
+// "=" and "," spaced, calls and indexing tight: f(a, b), t[k], {a = 1, 2}.
+// What does not fit in the width (Width, 100 columns) is broken over lines,
+// as Wadler's and Oppen's pretty printers do (the variant of Prettier: a
+// group is laid out flat if it fits up to the next possible line break,
+// else broken):
+//
+//   - arguments, parameters and table fields one a line, indented, the
+//     closing bracket on a line of its own; a call whose last argument is a
+//     function or a table opens it on the line of the call and closes the
+//     call on the line of its end, if the line fits: f(a, function()
+//     ... end), setmetatable(t, { ... });
+//   - a chain of binary operators of the same precedence breaks after its
+//     operators, its operands indented one level (two in the condition of
+//     an if or a while, not to align with the block);
+//   - a list of values or targets breaks after its commas.
+//
+// The formatter keeps the author's choices (Chunk): the text of literals
+// (the quotes change only with Quotes), a.b or a["b"], f"s" and f{...},
+// parentheses, "else if", the empty lines between statements and between
+// table fields (one of several), one-line blocks and functions with at
+// most a statement in each block (if they fit), tables with a line break
+// after their "{" (laid out on lines). Options.TrailingComma ends the
+// tables laid out on lines with a ","; without it, they keep the trailing
+// separator of the source. A table's separators are written ",".
+// Options.KeepSemicolons keeps the ";" after statements; else they go.
+//
+// # Limits
+//
+// A built tree is printed so that it parses back to the same tree, but
+// for what Lua cannot write: a vararg function without "arg" under Lua 5.1
+// (ParList.NoArg) reads back with it, a NumberExpr's Value reads back as
+// the parser of the dialect writes numerals, an expression's lines are
+// those of its new text, parentheses that change nothing are dropped. The
+// LuaJIT parser emits code to check LuaJIT's limits (registers, constants):
+// a source at those limits can be one the formatter's parentheses or the
+// printer's lack of them move over the limit; the tests found none.
+package format
