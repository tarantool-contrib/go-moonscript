+	unit := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(j)), nil)
+	half := new(big.Int).Mul(big.NewInt(5), new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(j-1)), nil))
