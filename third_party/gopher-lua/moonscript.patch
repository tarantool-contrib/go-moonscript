+func TestIoOpenPermissions(t *testing.T) {
+	umask := syscall.Umask(022)
+	syscall.Umask(umask)
+	name := filepath.Join(t.TempDir(), "f")
+	L := NewState()
+	defer L.Close()
+	L.SetGlobal("name", LString(name))
+	if err := L.DoString(`assert(io.open(name, "w")):close()`); err != nil {
