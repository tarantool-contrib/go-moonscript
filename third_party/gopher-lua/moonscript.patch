+// decimalExponent is the exponent of f in decimal scientific notation.
+func decimalExponent(f float64) int {
+	s := strconv.FormatFloat(f, 'e', 16, 64)
+	x, _ := strconv.Atoi(s[strings.LastIndexByte(s, 'e')+1:])
+	return x
