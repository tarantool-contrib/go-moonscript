+
+// rStoreVar is luaK_storevar.
+func (fs *funcState) rStoreVar(p *parser, v, e *expDesc) {
+	switch v.k {
+	case vLocal:
+		fs.rFreeExp(e)
+		fs.rExp2Reg(e, v.info)
+		return
+	case vUpval, vGlobal:
+		fs.rExp2AnyReg(p, e)
+	default: // vIndexed
+		fs.rExp2RK(p, e)
+	}
+	fs.rFreeExp(e)
