+		checkTree(t, d, "return g(), f()\n", ret(adjusted(call(g)), call(f)))
+		checkTree(t, d, "local a, b = (f())\n", local([]string{"a", "b"}, adjusted(call(f))))
+		checkTree(t, d, "f((g()))\n", callStmt(call(f, adjusted(call(g)))))
