+// rConstFolding is constfolding.
+func rConstFolding(op lua51Op, e1, e2 *expDesc) bool {
+	if !isNumeral51(e1) || !isNumeral51(e2) {
+		return false
+	}
+	v1, v2 := e1.nval, e2.nval
+	var r float64
+	switch op {
+	case op51Add:
+		r = v1 + v2
+	case op51Sub:
+		r = v1 - v2
+	case op51Mul:
+		r = v1 * v2
+	case op51Div:
+		if v2 == 0 {
+			return false
+		}
+		r = v1 / v2
+	case op51Mod:
+		if v2 == 0 {
+			return false
+		}
+		r = v1 - float64(math.Floor(v1/v2)*v2)
+	case op51Pow:
+		r = math.Pow(v1, v2)
+	case op51Unm:
+		r = -v1
+	default: // op51Len
+		return false
+	}
+	if math.IsNaN(r) {
+		return false
+	}
+	e1.nval = r
+	return true
