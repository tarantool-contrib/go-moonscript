+// cvttsd2si is the conversion of a double to a long of C on x86-64: the
+// value truncated, and LONG_MIN for a NaN or a value out of range.
+func cvttsd2si(f float64) int64 {
+	if f >= -(1<<63) && f < 1<<63 {
+		return int64(f)
+	}
+	return math.MinInt64
