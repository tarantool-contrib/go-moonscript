+		t.Fatalf("queue of 10 elements: array part of %d, hash part of %d", len(tbl.array), len(tbl.hash.nodes))
+	}
+	for i := first; i <= last; i++ {
+		tfEqual(t, LNumber(i), tbl.RawGetInt(i))
+	}
