+	cm := format.NewCommentMap(chunk)
+	for _, s := range chunk.Stmts {
+		for _, c := range cm[s] {
+			fmt.Printf("%q: %s of the statement on line %d\n", c.Raw, c.Place, chunk.Pos(s.Span().Start).Line)
+		}
+	}
