+type countVisitor struct {
+	visits, leaves *int
+	skip           func(ast.Element) bool
+}
+
+func (v countVisitor) Visit(n ast.Element) ast.Visitor {
+	if n == nil {
+		*v.leaves++
+		return nil
+	}
+	*v.visits++
+	if v.skip != nil && v.skip(n) {
+		return nil
+	}
+	return v
+}
