+func tzPanics(t *testing.T, name string, f func()) {
+	t.Helper()
+	defer func() {
+		t.Helper()
+		r := recover()
+		if err, ok := r.(error); !ok || !errors.Is(err, ErrFrozenTable) {
+			t.Errorf("%s: recovered %v, want ErrFrozenTable", name, r)
+		}
+	}()
+	f()
+}
