+			"AssignStmt 1:1-3:5 x = [[\nab\r\ncd]]", "IdentExpr 1:1-1:2 x", "StringExpr 1:5-3:5 [[\nab\r\ncd]]",
+			"AssignStmt 3:6-3:11 y = 1", "IdentExpr 3:6-3:7 y", "NumberExpr 3:10-3:11 1"}, ""},
