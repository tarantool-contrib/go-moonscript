+
+local Point = {}
+Point.__index = Point
+function Point.new(x, y) return setmetatable({x = x, y = y}, Point) end
+function Point:add(o) return Point.new(self.x + o.x, self.y + o.y) end
+local p = Point.new(0, 0)
+for i = 1, 50000 do p = p:add(Point.new(1, i)) end
