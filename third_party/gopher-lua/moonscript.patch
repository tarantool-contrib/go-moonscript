+// go-moonscript patch: tests of the spans, positions, parentheses and
+// comments of the tree (ast/doc.go), and of the walker.
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"errors"
+	"fmt"
+	"io"
