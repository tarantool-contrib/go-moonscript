+-- The lexer's errors are Lua 5.1's (read_numeral, read_string,
+-- read_long_string), and it accepts what Lua 5.1 accepts: gopher-lua's
+-- said "unterminated string", "invalid multiline string" and accepted
+-- nested [[ ]], "\300" (as a byte 44), its errors were on other lines.
+local function try(src)
+  local f, err = loadstring(src, "=src")
+  if f then
+    print("ok", f())
+  else
+    err = err:gsub("^[^:]*:", ""):gsub("[^%w%p ]", function(c) return "\\" .. c:byte() end)
+    print(err)
+  end
+end
+-- numerals
+try("return 1e")
+try("return 1e+")
+try("return 1e5x")
+try("return 1..2")
+try("return 3..2")
+try("return .5e")
+try("return 08, 1e2, 1E-2, .5, 5., 0x10, 0XaB")
+try("return 0x")
+try("return 0x1g")
+try("return 0x.8")
+try("return 0x1p4")
+try("return 0x1P-2")
+try("return 0x1p")
+try("return 0b101")
+try("return 1LL")
+try("return 1ULL")
+try("return 0x10LL")
+try("return 1i")
+try("return 1.5ll")
+try("return 1__2")
+try("return 1\200")
+-- strings
+try("return 'abc")
+try("return 'abc\ndef'")
