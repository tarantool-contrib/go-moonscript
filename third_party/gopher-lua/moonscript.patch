@@ -0,0 +1,153 @@
+package scope_test
+
+import (
+	"archive/tar"
+	"compress/gzip"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/ast"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/parse"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/scope"
+)
+
+var dialects = []scope.Dialect{scope.Lua51, scope.LuaJIT}
+
+func parseDialect(d scope.Dialect) parse.Dialect {
+	if d == scope.LuaJIT {
+		return parse.LuaJIT
+	}
+	return parse.Lua51
+}
+
+// mustResolve parses and resolves src.
+func mustResolve(t testing.TB, src string, d scope.Dialect) (*ast.Chunk, *scope.Info) {
+	t.Helper()
+	chunk, err := parse.ParseChunk([]byte(src), "test", parse.Options{Dialect: parseDialect(d)})
+	if err != nil {
+		t.Fatalf("%v: parse %q: %v", d, src, err)
+	}
+	info, err := scope.Resolve(chunk, d)
+	if err != nil {
+		t.Fatalf("%v: resolve %q: %v", d, src, err)
+	}
+	return chunk, info
+}
+
+// refs lists the occurrences of names in source order as
+// "x:read->global y:write->local#0", without positions.
+func refs(info *scope.Info, chunk *ast.Chunk) string {
+	var parts []string
+	for i := range info.Refs {
+		r := &info.Refs[i]
+		to := "global"
+		if r.Var != nil {
+			to = fmt.Sprintf("%s#%d", r.Var.Kind, declOrdinal(info, r.Var))
+		}
+		parts = append(parts, fmt.Sprintf("%s:%s->%s", r.Name(), r.Kind, to))
+	}
+	return strings.Join(parts, " ")
+}
+
+// declOrdinal is the index of the variable among the variables of its name.
+func declOrdinal(info *scope.Info, v *scope.Var) int {
+	n := 0
+	for _, u := range info.Vars {
+		if u.Name == v.Name {
+			if u == v {
+				return n
+			}
+			n++
+		}
+	}
+	return -1
+}
+
+// luaFiles returns the Lua files under dir (and its subdirectories), by
+// path.
+func luaFiles(tb testing.TB, dir string) map[string][]byte {
+	tb.Helper()
+	files := map[string][]byte{}
+	err := filepath.WalkDir(dir, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !d.IsDir() && strings.HasSuffix(path, ".lua") {
+			b, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			files[path] = b
+		}
+		return nil
+	})
+	if err != nil {
+		tb.Fatal(err)
+	}
+	return files
+}
+
+// archivesDir holds go-moonscript's archives of Lua test suites and
+// projects (internal/luasuites).
+var archivesDir = filepath.Join("..", "..", "..", "internal", "luasuites", "testdata", "archives")
+
+// archiveFiles returns the Lua files of the luasuites archives.
+func archiveFiles(tb testing.TB) map[string][]byte {
+	tb.Helper()
+	paths, _ := filepath.Glob(filepath.Join(archivesDir, "*.tar.gz"))
+	if len(paths) == 0 {
+		tb.Skip("no archives in", archivesDir)
+	}
+	files := map[string][]byte{}
+	for _, p := range paths {
+		if err := readTarGz(p, files); err != nil {
+			tb.Fatal(err)
+		}
+	}
+	return files
+}
+
+func readTarGz(path string, files map[string][]byte) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = f.Close() }()
+	zr, err := gzip.NewReader(f)
+	if err != nil {
+		return err
+	}
+	tr := tar.NewReader(zr)
+	for {
+		hdr, err := tr.Next()
+		if errors.Is(err, io.EOF) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if hdr.Typeflag != tar.TypeReg || !strings.HasSuffix(hdr.Name, ".lua") && !strings.HasSuffix(hdr.Name, ".t") {
+			continue
+		}
+		b, err := io.ReadAll(tr)
+		if err != nil {
+			return err
+		}
+		files[filepath.Base(path)+"/"+hdr.Name] = b
+	}
+}
+
+func sortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
--- a/scope/oracle_test.go
+++ b/scope/oracle_test.go
@@ -0,0 +1,267 @@
+package scope_test
+
+// The compiler is the oracle: it resolves names as the parsers do, and
+// leaves what it resolved in the function prototypes it builds: the upvalues
+// by name and in order (DbgUpvalues), the locals (DbgLocals), and the
+// globals and upvalues each instruction uses (GETGLOBAL, SETGLOBAL,
+// GETUPVAL, SETUPVAL). For every function of every source, the resolver's
+// answer must be the compiler's:
+//
+//   - the upvalues of the function are the names the compiler lists, in its
+//     order, and each is a variable captured by the function;
+//   - the names of the globals read and written directly in the function
+//     are the constants of its GETGLOBAL and SETGLOBAL, as many times;
+//   - the upvalues read and written are the operands of its GETUPVAL and
+//     SETUPVAL, as many times;
+//   - the variables declared in the function are its debug locals (the
+//     hidden control variables of for loops left out).
+
+import (
+	"fmt"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	lua "github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/ast"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/parse"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/scope"
+)
+
+func luaDialect(d scope.Dialect) lua.Dialect {
+	if d == scope.LuaJIT {
+		return lua.DialectLuaJIT
+	}
+	return lua.DialectLua51
+}
+
+// oracleStats counts what an oracle run compared.
+type oracleStats struct {
+	sources, parseErrors, compileErrors int
+	functions, upvalues, globalRefs     int
+	upvalueRefs, locals                 int
+}
+
+func (s *oracleStats) add(o oracleStats) {
+	s.sources += o.sources
+	s.parseErrors += o.parseErrors
+	s.compileErrors += o.compileErrors
+	s.functions += o.functions
+	s.upvalues += o.upvalues
+	s.globalRefs += o.globalRefs
+	s.upvalueRefs += o.upvalueRefs
+	s.locals += o.locals
+}
+
+// compilerOracle parses, resolves and compiles src, and returns the
+// differences between the resolver and the compiler, with counts of what it
+// compared.
+func compilerOracle(src []byte, d scope.Dialect) (stats oracleStats, diffs []string) {
+	stats.sources = 1
+	chunk, err := parse.ParseChunk(src, "oracle", parse.Options{Dialect: parseDialect(d)})
+	if err != nil {
+		stats.parseErrors = 1
+		return stats, nil
+	}
+	proto, err := lua.CompileAST(chunk.Stmts, "=oracle", luaDialect(d))
+	if err != nil {
+		stats.compileErrors = 1
+		return stats, nil
+	}
+	info, err := scope.Resolve(chunk, d)
+	if err != nil {
+		return stats, []string{"resolve: " + err.Error()}
+	}
+	var funcs []*scope.Scope
+	for _, s := range info.Scopes {
+		if s.IsFunction() {
+			funcs = append(funcs, s)
+		}
+	}
+	var protos []*lua.FunctionProto
+	var collect func(*lua.FunctionProto)
+	collect = func(p *lua.FunctionProto) {
+		protos = append(protos, p)
+		for _, c := range p.FunctionPrototypes {
+			collect(c)
+		}
+	}
+	collect(proto)
+	if len(funcs) != len(protos) {
+		return stats, []string{fmt.Sprintf("%d function scopes, %d prototypes", len(funcs), len(protos))}
+	}
+	// per function: the references made directly in it
+	globalReads := map[*scope.Scope]map[string]int{}
+	globalWrites := map[*scope.Scope]map[string]int{}
+	upReads := map[*scope.Scope]map[string]int{}
+	upWrites := map[*scope.Scope]map[string]int{}
+	bump := func(m map[*scope.Scope]map[string]int, s *scope.Scope, name string) {
+		if m[s] == nil {
+			m[s] = map[string]int{}
+		}
+		m[s][name]++
+	}
+	for i := range info.Refs {
+		r := &info.Refs[i]
+		f := r.Scope.Func
+		switch {
+		case r.Kind == scope.Jump:
+		case r.Var == nil && r.Kind == scope.Read:
+			bump(globalReads, f, r.Name())
+		case r.Var == nil:
+			bump(globalWrites, f, r.Name())
+		case r.IsUpvalue() && r.Kind == scope.Read:
+			bump(upReads, f, r.Name())
+		case r.IsUpvalue():
+			bump(upWrites, f, r.Name())
+		}
+	}
+	for i, s := range funcs {
+		p := protos[i]
+		stats.functions++
+		where := fmt.Sprintf("function %d (line %d)", i, p.LineDefined)
+		if fe, ok := s.Node.(*ast.FunctionExpr); ok && p.LineDefined != fe.Line() {
+			diffs = append(diffs, fmt.Sprintf("%s: scope's function is at line %d", where, fe.Line()))
+			continue
+		}
+		// upvalues
+		var ups []string
+		for _, u := range s.Upvalues {
+			ups = append(ups, u.Name)
+			if !u.Captured {
+				diffs = append(diffs, fmt.Sprintf("%s: upvalue %s of a variable not captured", where, u.Name))
+			}
+			if u.Scope.Func == s {
+				diffs = append(diffs, fmt.Sprintf("%s: upvalue %s is its own variable", where, u.Name))
+			}
+		}
+		if !equal(ups, p.DbgUpvalues) {
+			diffs = append(diffs, fmt.Sprintf("%s: upvalues %v, compiler %v", where, ups, p.DbgUpvalues))
+		}
+		stats.upvalues += len(ups)
+		// the operands of the instructions
+		gets, sets := map[string]int{}, map[string]int{}
+		upgets, upsets := map[string]int{}, map[string]int{}
+		for pc := 0; pc < len(p.Code); pc++ {
+			ins := p.Code[pc]
+			op := int(ins >> 26)
+			b := int(ins & 0x1ff)
+			bx := int(ins & 0x3ffff)
+			switch op {
+			case lua.OP_GETGLOBAL:
+				gets[string(p.Constants[bx].(lua.LString))]++
+			case lua.OP_SETGLOBAL:
+				sets[string(p.Constants[bx].(lua.LString))]++
+			case lua.OP_GETUPVAL:
+				upgets[p.DbgUpvalues[b]]++
+			case lua.OP_SETUPVAL:
+				upsets[p.DbgUpvalues[b]]++
+			case lua.OP_CLOSURE:
+				// the MOVE and GETUPVAL after it say what the closure captures
+				pc += len(p.FunctionPrototypes[bx].DbgUpvalues)
+			}
+		}
+		diffs = compareCounts(diffs, where, "global reads", globalReads[s], gets)
+		diffs = compareCounts(diffs, where, "global writes", globalWrites[s], sets)
+		diffs = compareCounts(diffs, where, "upvalue reads", upReads[s], upgets)
+		diffs = compareCounts(diffs, where, "upvalue writes", upWrites[s], upsets)
+		for _, n := range gets {
+			stats.globalRefs += n
+		}
+		for _, n := range sets {
+			stats.globalRefs += n
+		}
+		for _, n := range upgets {
+			stats.upvalueRefs += n
+		}
+		for _, n := range upsets {
+			stats.upvalueRefs += n
+		}
+		// locals
+		var locals, dbg []string
+		for _, v := range info.Vars {
+			if v.Scope.Func == s && v.Kind != scope.KindLabel {
+				locals = append(locals, v.Name)
+			}
+		}
+		for _, l := range p.DbgLocals {
+			if !strings.HasPrefix(l.Name, "(") {
+				dbg = append(dbg, l.Name)
+			}
+		}
+		sort.Strings(locals)
+		sort.Strings(dbg)
+		if !equal(locals, dbg) {
+			diffs = append(diffs, fmt.Sprintf("%s: locals %v, compiler %v", where, locals, dbg))
+		}
+		stats.locals += len(locals)
+	}
+	return stats, diffs
+}
+
+func equal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func compareCounts(diffs []string, where, what string, got, want map[string]int) []string {
+	for name, n := range got {
+		if want[name] != n {
+			diffs = append(diffs, fmt.Sprintf("%s: %s of %q: %d, compiler %d", where, what, name, n, want[name]))
+		}
+	}
+	for name, n := range want {
+		if _, ok := got[name]; !ok {
+			diffs = append(diffs, fmt.Sprintf("%s: %s of %q: 0, compiler %d", where, what, name, n))
+		}
+	}
+	return diffs
+}
+
+// runOracle runs the compiler oracle over files in both dialects.
+func runOracle(t *testing.T, label string, files map[string][]byte) {
+	t.Helper()
+	for _, d := range dialects {
+		var total oracleStats
+		failed := 0
+		for _, name := range sortedKeys(files) {
+			stats, diffs := compilerOracle(files[name], d)
+			total.add(stats)
+			if len(diffs) > 0 {
+				failed++
+				if failed <= 10 {
+					t.Errorf("%s (%v): %d differences, first: %s", name, d, len(diffs), diffs[0])
+				}
+			}
+		}
+		t.Logf("%s, %v: %d sources (%d do not parse, %d do not compile), %d functions, %d upvalues, %d global refs, %d upvalue refs, %d locals compared; %d sources differ",
+			label, d, total.sources, total.parseErrors, total.compileErrors, total.functions, total.upvalues, total.globalRefs, total.upvalueRefs, total.locals, failed)
+	}
+}
+
+// TestOracleCompat runs the compiler oracle over the compatibility
+// scripts and the other Lua files of the fork's testdata.
+func TestOracleCompat(t *testing.T) {
+	files := luaFiles(t, filepath.Join("..", "testdata"))
+	if len(files) == 0 {
+		t.Fatal("no scripts")
+	}
+	runOracle(t, "testdata", files)
+}
+
+// TestOracleArchives runs the compiler oracle over the Lua files of the
+// luasuites archives.
+func TestOracleArchives(t *testing.T) {
+	if testing.Short() {
+		t.Skip("short")
+	}
+	runOracle(t, "archives", archiveFiles(t))
+}
--- a/scope/resolve.go
+++ b/scope/resolve.go
@@ -0,0 +1,755 @@
+package scope
+
+import (
+	"fmt"
+
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/ast"
+)
+
+// maxDepth is how deep Resolve recurses into a tree: the compiler's limit
+// (maxCompileDepth), which also stops a tree with a cycle.
+const maxDepth = 100000
+
+// Resolve resolves the names of a chunk. The tree is not modified. It
+// returns the Info of what it resolved, and an *Error if the tree has
+// problems with its labels (a parsed tree has none).
+func Resolve(chunk *ast.Chunk, dialect Dialect) (*Info, error) {
+	if chunk == nil {
+		return ResolveStmts(nil, dialect)
+	}
+	return resolve(chunk, chunk.Stmts, dialect)
+}
+
+// ResolveStmts resolves the names of the statements of a chunk, a tree
+// that the parser built or other code did. The root scope has no node and
+// no span.
+func ResolveStmts(stmts []ast.Stmt, dialect Dialect) (*Info, error) {
+	return resolve(nil, stmts, dialect)
+}
+
+func resolve(chunk *ast.Chunk, stmts []ast.Stmt, dialect Dialect) (*Info, error) {
+	in := &Info{Dialect: dialect, chunk: chunk}
+	r := &resolver{info: in, dialect: dialect}
+	var node ast.Element
+	var span ast.Span
+	if chunk != nil {
+		node, span = chunk, chunk.Span()
+		// the sizes the archives have: a name occurrence per 42 bytes of
+		// source, a variable per 144, a scope per 250
+		n := span.End
+		in.Refs = make([]Ref, 0, n/36+1)
+		in.Vars = make([]*Var, 0, n/140+1)
+		in.Scopes = make([]*Scope, 0, n/240+1)
+		r.varHint, r.scopeHint = n/140+1, n/240+1
+	}
+	r.act = make([]*Var, 0, 32)
+	root := r.openFunc(node, span)
+	r.stmtList(stmts, true)
+	r.closeFunc(root)
+	in.Root = root.scope
+	r.finish()
+	if len(in.Problems) > 0 {
+		return in, &Error{Problems: in.Problems}
+	}
+	return in, nil
+}
+
+// resolver is the state of a resolution: the active variables, the
+// function and the blocks being resolved, the labels and gotos.
+type resolver struct {
+	info    *Info
+	dialect Dialect
+
+	act    []*Var // the active variables of all enclosing functions
+	fn     *funcState
+	cur    *Scope
+	blocks []blockState
+	gola   []golaEntry
+
+	depth   int
+	aborted bool
+
+	varSlab   []Var
+	scopeSlab []Scope
+	// the capacity of the first slab of each
+	varHint, scopeHint int
+}
+
+// funcState is a function being resolved.
+type funcState struct {
+	parent    *funcState
+	scope     *Scope
+	actBase   int // len(act) at its start
+	golaBase  int
+	blockBase int // len(blocks) at its start
+}
+
+// blockState is a block of the function being resolved (lj_parse.c's
+// FuncScope, for the labels).
+type blockState struct {
+	nact    int // the function's active variables at its start
+	vstart  int // where its gotos and labels start in gola
+	hasGola bool
+}
+
+// golaEntry is a pending goto or a label (lj_parse.c's VarInfo).
+type golaEntry struct {
+	name    string
+	isLabel bool
+	valid   bool
+	slot    int  // the function's active variables there
+	ref     int  // for a goto, its index in Info.Refs
+	label   *Var // for a label
+}
+
+// slabSize is the capacity of the next slab: hint for the first, then
+// twice the last up to limit.
+func slabSize(last, hint, limit int) int {
+	if last == 0 {
+		return max(hint, 8)
+	}
+	return min(2*last, limit)
+}
+
+func (r *resolver) newVar() *Var {
+	if len(r.varSlab) == cap(r.varSlab) {
+		r.varSlab = make([]Var, 0, slabSize(cap(r.varSlab), r.varHint, 1024))
+	}
+	r.varSlab = r.varSlab[:len(r.varSlab)+1]
+	v := &r.varSlab[len(r.varSlab)-1]
+	v.ID = len(r.info.Vars)
+	r.info.Vars = append(r.info.Vars, v)
+	return v
+}
+
+func (r *resolver) newScope(kind ScopeKind, node ast.Element, span ast.Span) *Scope {
+	if len(r.scopeSlab) == cap(r.scopeSlab) {
+		r.scopeSlab = make([]Scope, 0, slabSize(cap(r.scopeSlab), r.scopeHint, 512))
+	}
+	r.scopeSlab = r.scopeSlab[:len(r.scopeSlab)+1]
+	s := &r.scopeSlab[len(r.scopeSlab)-1]
+	s.Kind, s.Node, s.Span, s.Parent = kind, node, span, r.cur
+	s.ID = len(r.info.Scopes)
+	s.Func = s
+	if r.cur != nil {
+		s.Func = r.cur.Func
+	}
+	r.info.Scopes = append(r.info.Scopes, s)
+	return s
+}
+
+// declare makes a variable, not yet active.
+func (r *resolver) declare(name string, kind VarKind, decl ast.Element, index int, span ast.Span) *Var {
+	v := r.newVar()
+	v.Name, v.Kind, v.Decl, v.Index, v.NameSpan = name, kind, decl, index, span
+	return v
+}
+
+// activate makes a declared variable visible, in the current scope.
+func (r *resolver) activate(v *Var) {
+	v.Scope = r.cur
+	v.Shadows = r.lookup(v.Name)
+	r.act = append(r.act, v)
+}
+
+// lookup finds the variable a name refers to, nil for a global.
+func (r *resolver) lookup(name string) *Var {
+	act := r.act
+	for i := len(act) - 1; i >= 0; i-- {
+		if v := act[i]; v.Name == name {
+			return v
+		}
+	}
+	return nil
+}
+
+func (r *resolver) nact() int { return len(r.act) - r.fn.actBase }
+
+func (r *resolver) problem(node ast.Element, span ast.Span, format string, args ...any) {
+	r.info.Problems = append(r.info.Problems, Problem{Node: node, Span: span, Msg: fmt.Sprintf(format, args...)})
+}
+
+// ref records an occurrence of a name.
+func (r *resolver) ref(id *ast.IdentExpr, kind RefKind) {
+	v := r.lookup(id.Value)
+	r.info.Refs = append(r.info.Refs, Ref{Kind: kind, Ident: id, Var: v, Scope: r.cur})
+	if v != nil {
+		if kind == Write {
+			v.nw++
+		} else {
+			v.nr++
+		}
+		if v.Scope.Func != r.cur.Func {
+			r.capture(v)
+		}
+	}
+}
+
+// capture makes v an upvalue of the current function and of those between
+// it and the function declaring v.
+func (r *resolver) capture(v *Var) {
+	v.Captured = true
+	for f := r.fn; f != nil && f.scope != v.Scope.Func; f = f.parent {
+		s := f.scope
+		found := false
+		for _, u := range s.Upvalues {
+			if u == v {
+				found = true
+				break
+			}
+		}
+		if !found {
+			s.Upvalues = append(s.Upvalues, v)
+		}
+	}
+}
+
+/* functions and blocks */
+
+// openFunc starts a function: its scope and its outermost block.
+func (r *resolver) openFunc(node ast.Element, span ast.Span) *funcState {
+	fs := &funcState{parent: r.fn, actBase: len(r.act), golaBase: len(r.gola), blockBase: len(r.blocks)}
+	s := r.newScope(ScopeFunction, node, span)
+	s.Func = s
+	fs.scope = s
+	r.cur = s
+	r.fn = fs
+	r.blocks = append(r.blocks, blockState{vstart: len(r.gola)})
+	return fs
+}
+
+func (r *resolver) closeFunc(fs *funcState) {
+	r.leaveBlock()
+	r.gola = r.gola[:fs.golaBase]
+	r.blocks = r.blocks[:fs.blockBase]
+	r.act = r.act[:fs.actBase]
+	r.cur = fs.scope.Parent
+	r.fn = fs.parent
+}
+
+// openScope starts a block with a scope of its own.
+func (r *resolver) openScope(kind ScopeKind, node ast.Element, span ast.Span) *Scope {
+	s := r.newScope(kind, node, span)
+	r.cur = s
+	r.blocks = append(r.blocks, blockState{nact: r.nact(), vstart: len(r.gola)})
+	return s
+}
+
+func (r *resolver) closeScope() {
+	r.leaveBlock()
+	r.cur = r.cur.Parent
+}
+
+// leaveBlock ends the current block: its variables go out of scope, its
+// labels are resolved and its gotos passed on (fscope_end).
+func (r *resolver) leaveBlock() {
+	i := len(r.blocks) - 1
+	bl := r.blocks[i]
+	r.act = r.act[:r.fn.actBase+bl.nact]
+	if bl.hasGola {
+		r.golaFixup(&bl, i > r.fn.blockBase)
+	}
+	r.blocks = r.blocks[:i]
+}
+
+// golaFixup resolves the gotos back to the labels of the block going out
+// of scope and passes the others on to the enclosing block, if there is
+// one in the function; it is an error in the function's (gola_fixup).
+func (r *resolver) golaFixup(bl *blockState, hasParent bool) {
+	for i := bl.vstart; i < len(r.gola); i++ {
+		v := &r.gola[i]
+		if !v.valid {
+			continue
+		}
+		switch {
+		case v.isLabel:
+			v.valid = false
+			for j := i + 1; j < len(r.gola); j++ {
+				if g := &r.gola[j]; g.valid && !g.isLabel && g.name == v.name {
+					r.bind(g, v.label)
+				}
+			}
+		case hasParent:
+			r.blocks[len(r.blocks)-2].hasGola = true
+			v.slot = bl.nact
+		default:
+			v.valid = false
+			ref := &r.info.Refs[v.ref]
+			r.problem(ref.Goto, ref.Span(), "undefined label '%s'", v.name)
+		}
+	}
+}
+
+// bind makes a goto jump to a label.
+func (r *resolver) bind(g *golaEntry, label *Var) {
+	g.valid = false
+	ref := &r.info.Refs[g.ref]
+	ref.Var = label
+	label.nr++
+}
+
+/* statements */
+
+// stmtList resolves the statements of a block; trailing says whether the
+// labels at its end are out of its locals' scope (it is not for the body
+// of a repeat, which "until" follows).
+func (r *resolver) stmtList(list []ast.Stmt, trailing bool) {
+	// the labels from tail on are at the end of the block
+	tail := len(list)
+	if r.dialect == LuaJIT && trailing {
+		for tail > 0 {
+			if l, ok := list[tail-1].(*ast.LabelStmt); !ok || l == nil {
+				break
+			}
+			tail--
+		}
+	} else {
+		tail = len(list) + 1
+	}
+	for i, s := range list {
+		if r.aborted {
+			return
+		}
+		if l, ok := s.(*ast.LabelStmt); ok && l != nil {
+			r.label(l, i >= tail)
+			continue
+		}
+		r.stmt(s)
+	}
+}
+
+// block resolves a block with a scope of its own.
+func (r *resolver) block(kind ScopeKind, node ast.Element, span ast.Span, list []ast.Stmt) {
+	r.openScope(kind, node, span)
+	r.stmtList(list, true)
+	r.closeScope()
+}
+
+func (r *resolver) stmt(s ast.Stmt) {
+	if r.depth >= maxDepth {
+		r.tooDeep(s)
+		return
+	}
+	r.depth++
+	r.stmt1(s)
+	r.depth--
+}
+
+func (r *resolver) tooDeep(n ast.Element) {
+	if !r.aborted {
+		r.aborted = true
+		r.problem(n, ast.Span{}, "syntax tree too deep")
+	}
+}
+
+func (r *resolver) stmt1(s ast.Stmt) {
+	switch st := s.(type) {
+	case *ast.AssignStmt:
+		if st == nil {
+			return
+		}
+		for _, e := range st.Lhs {
+			if id, ok := e.(*ast.IdentExpr); ok && id != nil {
+				r.ref(id, Write)
+			} else {
+				r.expr(e)
+			}
+		}
+		r.exprs(st.Rhs)
+	case *ast.LocalAssignStmt:
+		if st == nil {
+			return
+		}
+		r.localAssign(st)
+	case *ast.FuncCallStmt:
+		if st == nil {
+			return
+		}
+		r.expr(st.Expr)
+	case *ast.DoBlockStmt:
+		if st == nil {
+			return
+		}
+		r.block(ScopeDo, st, st.StmtsSpan, st.Stmts)
+	case *ast.WhileStmt:
+		if st == nil {
+			return
+		}
+		r.expr(st.Condition)
+		r.block(ScopeWhile, st, st.StmtsSpan, st.Stmts)
+	case *ast.RepeatStmt:
+		if st == nil {
+			return
+		}
+		span := st.StmtsSpan
+		if end := outerEnd(st.Condition); end > span.End {
+			span.End = end
+		}
+		r.openScope(ScopeRepeat, st, span)
+		r.stmtList(st.Stmts, false)
+		r.expr(st.Condition) // sees the locals of the body
+		r.closeScope()
+	case *ast.IfStmt:
+		for st != nil {
+			r.expr(st.Condition)
+			r.block(ScopeThen, st, st.ThenSpan, st.Then)
+			if len(st.Else) == 1 {
+				if ei, ok := st.Else[0].(*ast.IfStmt); ok && ei != nil { // an elseif
+					st = ei
+					continue
+				}
+			}
+			if len(st.Else) > 0 {
+				r.block(ScopeElse, st, st.ElseSpan, st.Else)
+			}
+			break
+		}
+	case *ast.NumberForStmt:
+		if st == nil {
+			return
+		}
+		v := r.declare(st.Name, KindForNum, st, 0, st.NameSpan)
+		r.expr(st.Init)
+		r.expr(st.Limit)
+		r.expr(st.Step)
+		r.openScope(ScopeFor, st, st.StmtsSpan)
+		r.activate(v)
+		r.block(ScopeForBody, st, st.StmtsSpan, st.Stmts)
+		r.closeScope()
+	case *ast.GenericForStmt:
+		if st == nil {
+			return
+		}
+		var buf [8]*Var
+		vars := buf[:0]
+		for i, name := range st.Names {
+			vars = append(vars, r.declare(name, KindForIn, st, i, spanAt(st.NameSpans, i)))
+		}
+		r.exprs(st.Exprs)
+		r.openScope(ScopeFor, st, st.StmtsSpan)
+		for _, v := range vars {
+			r.activate(v)
+		}
+		r.block(ScopeForBody, st, st.StmtsSpan, st.Stmts)
+		r.closeScope()
+	case *ast.FuncDefStmt:
+		if st == nil || st.Name == nil {
+			if st != nil {
+				r.function(st.Func, false)
+			}
+			return
+		}
+		method := false
+		switch {
+		case st.Name.Func != nil:
+			if id, ok := st.Name.Func.(*ast.IdentExpr); ok && id != nil {
+				r.ref(id, Write)
+			} else {
+				r.expr(st.Name.Func)
+			}
+		case st.Name.Receiver != nil:
+			r.expr(st.Name.Receiver)
+			method = true
+		}
+		r.function(st.Func, method)
+	case *ast.ReturnStmt:
+		if st == nil {
+			return
+		}
+		r.exprs(st.Exprs)
+	case *ast.GotoStmt:
+		if st == nil {
+			return
+		}
+		r.goto_(st)
+	}
+}
+
+func spanAt(spans []ast.Span, i int) ast.Span {
+	if i < len(spans) {
+		return spans[i]
+	}
+	return ast.Span{}
+}
+
+func (r *resolver) localAssign(st *ast.LocalAssignStmt) {
+	var buf [8]*Var
+	vars := buf[:0]
+	fn := st.IsFunction && len(st.Names) == 1 && len(st.Exprs) == 1
+	if fn {
+		_, fn = st.Exprs[0].(*ast.FunctionExpr)
+	}
+	kind := KindLocal
+	if fn {
+		kind = KindLocalFunction
+	}
+	for i, name := range st.Names {
+		vars = append(vars, r.declare(name, kind, st, i, spanAt(st.NameSpans, i)))
+	}
+	if fn { // "local function f": f is visible in its body
+		r.activate(vars[0])
+		r.expr(st.Exprs[0])
+		return
+	}
+	r.exprs(st.Exprs)
+	for _, v := range vars {
+		r.activate(v)
+	}
+}
+
+func (r *resolver) goto_(st *ast.GotoStmt) {
+	if r.dialect != LuaJIT {
+		r.problem(st, st.LabelSpan, "goto needs LuaJIT")
+		return
+	}
+	r.info.Refs = append(r.info.Refs, Ref{Kind: Jump, Goto: st, Scope: r.cur})
+	r.gola = append(r.gola, golaEntry{name: st.Label, valid: true, slot: r.nact(), ref: len(r.info.Refs) - 1})
+	r.blocks[len(r.blocks)-1].hasGola = true
+}
+
+// label declares a label (parse_label); trailing says whether it is at the
+// end of its block.
+func (r *resolver) label(st *ast.LabelStmt, trailing bool) {
+	if r.dialect != LuaJIT {
+		r.problem(st, st.NameSpan, "labels need LuaJIT")
+		return
+	}
+	bl := &r.blocks[len(r.blocks)-1]
+	v := r.declare(st.Name, KindLabel, st, 0, st.NameSpan)
+	v.Scope = r.cur
+	for i := bl.vstart; i < len(r.gola); i++ {
+		if g := &r.gola[i]; g.valid && g.isLabel && g.name == st.Name {
+			r.problem(st, st.NameSpan, "duplicate label '%s'", st.Name)
+			return
+		}
+	}
+	slot := r.nact()
+	if trailing { // a label at the end of a block is out of the scope of its locals
+		slot = bl.nact
+	}
+	bl.hasGola = true
+	idx := len(r.gola)
+	r.gola = append(r.gola, golaEntry{name: st.Name, isLabel: true, valid: true, slot: slot, label: v})
+	// the pending gotos of the block before it (gola_resolve)
+	for i := bl.vstart; i < idx; i++ {
+		g := &r.gola[i]
+		if !g.valid || g.isLabel || g.name != st.Name {
+			continue
+		}
+		if g.slot < slot {
+			ref := &r.info.Refs[g.ref]
+			local := "?"
+			if k := r.fn.actBase + g.slot; k < len(r.act) {
+				local = r.act[k].Name
+			}
+			r.problem(ref.Goto, ref.Span(), "<goto %s> jumps into the scope of local '%s'", g.name, local)
+		}
+		r.bind(g, v)
+	}
+}
+
+/* expressions */
+
+// outerEnd returns the end of an expression with its parentheses, 0 for a
+// nil one (also a nil pointer).
+func outerEnd(e ast.Expr) (end int) {
+	if e == nil {
+		return 0
+	}
+	defer func() {
+		if recover() != nil {
+			end = 0
+		}
+	}()
+	return e.OuterSpan().End
+}
+
+func (r *resolver) exprs(list []ast.Expr) {
+	for _, e := range list {
+		r.expr(e)
+	}
+}
+
+func (r *resolver) expr(e ast.Expr) {
+	if r.depth >= maxDepth {
+		if e != nil {
+			r.tooDeep(e)
+		}
+		return
+	}
+	r.depth++
+	r.expr1(e)
+	r.depth--
+}
+
+func (r *resolver) expr1(e ast.Expr) {
+	switch x := e.(type) {
+	case *ast.IdentExpr:
+		if x != nil {
+			r.ref(x, Read)
+		}
+	case *ast.AttrGetExpr:
+		if x != nil {
+			r.expr(x.Object)
+			r.expr(x.Key)
+		}
+	case *ast.FuncCallExpr:
+		if x != nil {
+			if x.Func != nil {
+				r.expr(x.Func)
+			} else {
+				r.expr(x.Receiver)
+			}
+			r.exprs(x.Args)
+		}
+	case *ast.TableExpr:
+		if x != nil {
+			for _, f := range x.Fields {
+				if f != nil {
+					r.expr(f.Key)
+					r.expr(f.Value)
+				}
+			}
+		}
+	case *ast.LogicalOpExpr:
+		if x != nil {
+			r.expr(x.Lhs)
+			r.expr(x.Rhs)
+		}
+	case *ast.RelationalOpExpr:
+		if x != nil {
+			r.expr(x.Lhs)
+			r.expr(x.Rhs)
+		}
+	case *ast.ArithmeticOpExpr:
+		if x != nil {
+			r.expr(x.Lhs)
+			r.expr(x.Rhs)
+		}
+	case *ast.StringConcatOpExpr:
+		if x != nil {
+			r.expr(x.Lhs)
+			r.expr(x.Rhs)
+		}
+	case *ast.UnaryMinusOpExpr:
+		if x != nil {
+			r.expr(x.Expr)
+		}
+	case *ast.UnaryNotOpExpr:
+		if x != nil {
+			r.expr(x.Expr)
+		}
+	case *ast.UnaryLenOpExpr:
+		if x != nil {
+			r.expr(x.Expr)
+		}
+	case *ast.FunctionExpr:
+		r.function(x, false)
+	}
+}
+
+// function resolves a function; method gives it the implicit "self".
+func (r *resolver) function(fe *ast.FunctionExpr, method bool) {
+	if fe == nil {
+		return
+	}
+	if r.depth >= maxDepth {
+		r.tooDeep(fe)
+		return
+	}
+	r.depth++
+	fs := r.openFunc(fe, fe.Span())
+	if method {
+		r.activate(r.declare("self", KindSelf, fe, -1, ast.Span{}))
+	}
+	pl := fe.ParList
+	if pl != nil {
+		for i, name := range pl.Names {
+			r.activate(r.declare(name, KindParam, fe, i, spanAt(pl.NameSpans, i)))
+		}
+		if pl.HasVargs && r.dialect == Lua51 && !pl.NoArg && fs.parent != nil { // not the main function
+			r.activate(r.declare("arg", KindArg, fe, -1, ast.Span{}))
+		}
+	}
+	r.stmtList(fe.Stmts, true)
+	r.closeFunc(fs)
+	r.depth--
+}
+
+/* the result */
+
+// finish builds what the lists of a variable and a scope are carved from.
+func (r *resolver) finish() {
+	in := r.info
+	// the occurrences of each variable
+	total := 0
+	for _, v := range in.Vars {
+		total += int(v.nr + v.nw)
+	}
+	backing := make([]*Ref, total)
+	off := 0
+	for _, v := range in.Vars {
+		n, w := int(v.nr), int(v.nw)
+		v.Reads = backing[off : off : off+n]
+		v.Writes = backing[off+n : off+n : off+n+w]
+		off += n + w
+	}
+	var globals map[string]*Global
+	for i := range in.Refs {
+		ref := &in.Refs[i]
+		switch {
+		case ref.Var != nil && ref.Kind == Write:
+			ref.Var.Writes = append(ref.Var.Writes, ref)
+		case ref.Var != nil:
+			ref.Var.Reads = append(ref.Var.Reads, ref)
+		case ref.Kind != Jump:
+			if globals == nil {
+				globals = map[string]*Global{}
+			}
+			name := ref.Ident.Value
+			g := globals[name]
+			if g == nil {
+				g = &Global{Name: name}
+				globals[name] = g
+				in.Globals = append(in.Globals, g)
+			}
+			if ref.Kind == Write {
+				g.Writes = append(g.Writes, ref)
+			} else {
+				g.Reads = append(g.Reads, ref)
+			}
+		}
+	}
+	// the variables and children of each scope
+	for _, v := range in.Vars {
+		v.Scope.nv++
+		if v.Shadows != nil {
+			in.Shadowing = append(in.Shadowing, v)
+		}
+	}
+	nv, nc := 0, 0
+	for _, s := range in.Scopes {
+		nv += s.nv
+		if s.Parent != nil {
+			s.Parent.nc++
+			nc++
+		}
+	}
+	vb := make([]*Var, nv)
+	cb := make([]*Scope, nc)
+	nv, nc = 0, 0
+	for _, s := range in.Scopes {
+		s.Vars = vb[nv : nv : nv+s.nv]
+		nv += s.nv
+		s.Children = cb[nc : nc : nc+s.nc]
+		nc += s.nc
+	}
+	for _, v := range in.Vars {
+		v.Scope.Vars = append(v.Scope.Vars, v)
+	}
+	for _, s := range in.Scopes {
+		if s.Parent != nil {
+			s.Parent.Children = append(s.Parent.Children, s)
+		}
+	}
+}
--- a/scope/resolve_test.go
+++ b/scope/resolve_test.go
@@ -0,0 +1,558 @@
+package scope_test
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/ast"
+	"github.com/tarantool-contrib/go-moonscript/third_party/gopher-lua/scope"
+)
+
+// wantRefs checks the occurrences of names in src, in both dialects (or
+// only in the dialect given): "name:kind->what" in source order, what being
+// "global" or the kind of the variable and its index among the variables of
+// the name, "local#1" for the second local of that name.
+func wantRefs(t *testing.T, src, want string, only ...scope.Dialect) {
+	t.Helper()
+	ds := dialects
+	if len(only) > 0 {
+		ds = only
+	}
+	for _, d := range ds {
+		chunk, info := mustResolve(t, src, d)
+		if got := refs(info, chunk); got != want {
+			t.Errorf("%v: %s\n got: %s\nwant: %s", d, src, got, want)
+		}
+	}
+}
+
+func TestLocalSeesOuter(t *testing.T) {
+	wantRefs(t, "local x = x", "x:read->global")
+	wantRefs(t, "local x = 1; local x = x; return x", "x:read->local#0 x:read->local#1")
+	wantRefs(t, "local a, b = 1, 2; local a, b = b, a", "b:read->local#0 a:read->local#0")
+	wantRefs(t, "local a, a = 1, 2; return a", "a:read->local#1")
+	wantRefs(t, "local x; do local x = x end", "x:read->local#0")
+	wantRefs(t, "local x = function() return x end", "x:read->global")
+}
+
+func TestLocalFunction(t *testing.T) {
+	wantRefs(t, "local function f() return f end", "f:read->local function#0")
+	wantRefs(t, "local f = function() return f end", "f:read->global")
+	wantRefs(t, "local f; local function f() return f end", "f:read->local function#1")
+	wantRefs(t, "local function f() end; f()", "f:read->local function#0")
+}
+
+func TestRepeatUntil(t *testing.T) {
+	wantRefs(t, "repeat local a = 1 until a", "a:read->local#0")
+	wantRefs(t, "repeat local a = 1; local b = a until a == b", "a:read->local#0 a:read->local#0 b:read->local#0")
+	wantRefs(t, "repeat local a = a until a", "a:read->global a:read->local#0")
+	// the condition is not in the body's scope after the loop
+	wantRefs(t, "repeat local a until true; return a", "a:read->global")
+	// a closure in the condition sees the body's locals
+	wantRefs(t, "repeat local a until (function() return a end)()", "a:read->local#0")
+}
+
+func TestFor(t *testing.T) {
+	wantRefs(t, "for i = i, i, i do local i = i end", "i:read->global i:read->global i:read->global i:read->for variable#0")
+	wantRefs(t, "for i = 1, 2 do end; return i", "i:read->global")
+	wantRefs(t, "for k, v in k, v do return k, v end", "k:read->global v:read->global k:read->for variable#0 v:read->for variable#0")
+	wantRefs(t, "for k, v in pairs(t) do local k = k end return k", "pairs:read->global t:read->global k:read->for variable#0 k:read->global")
+	// the hidden control variables are no names, and no variables
+	for _, d := range dialects {
+		_, info := mustResolve(t, "for i = 1, 2 do end for k, v in next do end", d)
+		var names []string
+		for _, v := range info.Vars {
+			names = append(names, v.Name)
+		}
+		if got := strings.Join(names, " "); got != "i k v" {
+			t.Errorf("%v: variables %q", d, got)
+		}
+	}
+	// each variable is a new one per iteration for closures: still one Var
+	wantRefs(t, "for i = 1, 2 do f(function() return i end) end", "f:read->global i:read->for variable#0")
+}
+
+func TestMethods(t *testing.T) {
+	src := "function a.b:c(p, ...) return self, p, arg end"
+	wantRefs(t, src, "a:read->global self:read->self#0 p:read->parameter#0 arg:read->arg#0", scope.Lua51)
+	wantRefs(t, src, "a:read->global self:read->self#0 p:read->parameter#0 arg:read->global", scope.LuaJIT)
+	for _, d := range dialects {
+		_, info := mustResolve(t, src, d)
+		var kinds []string
+		for _, v := range info.Vars {
+			kinds = append(kinds, fmt.Sprintf("%s/%s/%d/%v", v.Name, v.Kind, v.Index, v.NameSpan != ast.Span{}))
+		}
+		want := "self/self/-1/false p/parameter/0/true"
+		if d == scope.Lua51 {
+			want += " arg/arg/-1/false"
+		}
+		if got := strings.Join(kinds, " "); got != want {
+			t.Errorf("%v: variables %q, want %q", d, got, want)
+		}
+	}
+	// not a method: no self
+	wantRefs(t, "function a.b.c() return self end", "a:read->global self:read->global")
+	wantRefs(t, "function a:b() return function() return self end end", "a:read->global self:read->self#0")
+	// a method call's receiver is read; its name is no variable
+	wantRefs(t, "local o; o:m(o)", "o:read->local#0 o:read->local#0")
+	// an explicit parameter self hides the implicit one
+	wantRefs(t, "function a:b(self) return self end", "a:read->global self:read->parameter#1")
+}
+
+func TestArg(t *testing.T) {
+	wantRefs(t, "return arg", "arg:read->global")
+	wantRefs(t, "return ...; ", "")
+	wantRefs(t, "return function(...) return arg end", "arg:read->arg#0", scope.Lua51)
+	wantRefs(t, "return function(...) return arg end", "arg:read->global", scope.LuaJIT)
+	wantRefs(t, "return function(a, ...) return arg end", "arg:read->arg#0", scope.Lua51)
+	wantRefs(t, "return function(a) return arg end", "arg:read->global")
+	wantRefs(t, "return function(arg, ...) return arg end", "arg:read->arg#1", scope.Lua51)
+	wantRefs(t, "return function(arg, ...) return arg end", "arg:read->parameter#0", scope.LuaJIT)
+	wantRefs(t, "local arg = 1; return function(...) return arg end", "arg:read->arg#1", scope.Lua51)
+	wantRefs(t, "local arg = 1; return function(...) return arg end", "arg:read->local#0", scope.LuaJIT)
+	// a tree built without NoArg, resolved for LuaJIT, has no arg either
+	stmts := []ast.Stmt{&ast.ReturnStmt{Exprs: []ast.Expr{&ast.FunctionExpr{
+		ParList: &ast.ParList{HasVargs: true},
+		Stmts:   []ast.Stmt{&ast.ReturnStmt{Exprs: []ast.Expr{&ast.IdentExpr{Value: "arg"}}}},
+	}}}}
+	for _, d := range dialects {
+		info, err := scope.ResolveStmts(stmts, d)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := info.Refs[0].Var != nil; got != (d == scope.Lua51) {
+			t.Errorf("%v: arg resolved: %v", d, got)
+		}
+	}
+	// ParList.NoArg turns it off under Lua51
+	stmts[0].(*ast.ReturnStmt).Exprs[0].(*ast.FunctionExpr).ParList.NoArg = true
+	info, _ := scope.ResolveStmts(stmts, scope.Lua51)
+	if info.Refs[0].Var != nil {
+		t.Error("NoArg: arg resolved")
+	}
+}
