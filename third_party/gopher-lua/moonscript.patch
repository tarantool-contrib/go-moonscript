+
+// rGoIfFalse is luaK_goiffalse.
+func (fs *funcState) rGoIfFalse(p *parser, e *expDesc) {
+	fs.rDischargeVars(e)
+	switch e.k {
+	case vKNil, vKFalse: // no jump
+	case vKTrue, vJmp:
+		e.t = hasJumps51
+	default:
+		fs.rJumpOnCond(p, e)
+		e.t = hasJumps51
+	}
+	e.f = jitNoJump
