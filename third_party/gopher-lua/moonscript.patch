+	case op51And:
+		fs.rDischargeVars(e2)
+		if e1.f != jitNoJump {
+			e2.f = hasJumps51
+		}
+		*e1 = *e2
+	case op51Or:
+		fs.rDischargeVars(e2)
+		if e1.t != jitNoJump {
