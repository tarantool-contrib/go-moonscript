+levels("table", function(n) return "return " .. r("{", n) .. r("}", n) end)
+levels("func", function(n) return r("function f() ", n) .. r("end ", n) end)
+levels("funcexpr", function(n) return "return " .. r("function() return ", n) .. "1" .. r(" end", n) end)
