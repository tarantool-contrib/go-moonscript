+		return JITNumberString(float64(n))
+	}
+	return n.String()
+}
+
+// lvAsString is LVAsString in the dialect of the state.
+func (ls *LState) lvAsString(v LValue) string {
+	if n, ok := v.(LNumber); ok && ls.Options.Dialect == DialectLuaJIT {
+		return JITNumberString(float64(n))
+	}
+	return LVAsString(v)
