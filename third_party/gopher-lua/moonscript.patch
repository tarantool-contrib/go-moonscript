+		{"a pointer key per pair", func(tb *LTable, _ int, _ LValue) {
+			tb.RawSet(newLTable(0, 0), LTrue)
+		}},
+		{"clear the current key, add a pointer key", func(tb *LTable, _ int, k LValue) {
+			tb.RawSet(k, LNil)
