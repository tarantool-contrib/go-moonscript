+-- remove and rename: nil, "<name>: <strerror>", errno
+local name = os.tmpname()
+local function hide(...)
+  local t = {...}
+  for i = 1, select("#", ...) do
+    if type(t[i]) == "string" then t[i] = t[i]:gsub(name, "<tmp>") end
+  end
+  return unpack(t, 1, select("#", ...))
