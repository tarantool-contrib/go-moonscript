+
+// rDischargeVars is luaK_dischargevars.
+func (fs *funcState) rDischargeVars(e *expDesc) {
+	switch e.k {
+	case vLocal:
+		e.k = vNonReloc
+	case vUpval, vGlobal:
+		e.k, e.aux = vRelocable, opOther51
+	case vIndexed:
+		fs.rFreeReg(e.aux)
+		fs.rFreeReg(e.info)
+		e.k, e.aux = vRelocable, opOther51
+	case vVararg, vCall:
