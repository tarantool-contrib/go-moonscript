+	if l.Count() != 4 || l.Start(1) != 0 || l.Start(2) != 4 || l.Start(3) != 6 || l.Start(4) != 8 || l.Start(5) != -1 || l.Start(0) != -1 {
+		t.Errorf("lines %d %d %d %d %d", l.Count(), l.Start(1), l.Start(2), l.Start(3), l.Start(4))
+	}
