+// rPrimK is nilK or boolK: nil, false, true are constants 0, 1, 2 of k51.
+func (fs *funcState) rPrimK(k expKind) uint32 {
+	if fs.k51[k] == 0 {
+		fs.nkn++
+		fs.k51[k] = fs.nkn
+	}
+	return fs.k51[k] - 1
