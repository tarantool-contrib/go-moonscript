------| @./lib/errors_on_load.moon
*    1| print "loading errors_on_load"
*    2| error "failed while loading"
     3| 

------| @./lib/util.moon
     1| -- a module found through package.moonpath (./?.moon -> ./lib/util.moon)
*    2| loaded_count = (loaded_count or 0) + 1
     3| 
*    4| class Stack
*    5|   new: => @items = {}
*    6|   push: (v) => table.insert @items, v
*    7|   pop: => table.remove @items
*    8|   size: => #@items
     9| 
    10| {
    11|   :Stack
*   12|   add: (a, b) -> a + b
    13|   name: ...
    14|   fail: (msg) -> error "util failed: #{msg}"
    15|   index_nil: -> nil_value.field
    16| }
    17| 

