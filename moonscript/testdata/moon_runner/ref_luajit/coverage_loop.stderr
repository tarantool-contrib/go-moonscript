------| @cov_loop.moon
     1| -- a CPU-bound script under moon -c (every line runs the coverage hook)
*    2| fib = (n) -> if n < 2 then n else fib(n - 1) + fib(n - 2)
*    3| total = 0
*    4| for i = 1, 2000
*    5|   total += i % 7
*    6| print fib(15), total
*    7| co = coroutine.create ->
*    8|   for i = 1, 3
*    9|     coroutine.yield i
*   10| for i = 1, 3
*   11|   print coroutine.resume co
    12| 

